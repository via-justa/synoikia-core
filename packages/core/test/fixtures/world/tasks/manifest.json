{
  "id": "tasks",
  "name": "Acme Tasks (World fixture)",
  "version": "1.0.0",
  "sdk": "^0.2.0",
  "entry": "index.mjs",
  "binding": {
    "namespace": "tasks",
    "functions": ["call"],
    "searchApis": ["registry", "guides"]
  },
  "capabilities": {
    "targets": true,
    "attestation": true,
    "configTransform": true,
    "registry": true
  },
  "targets": {
    "label": "List",
    "scopes": []
  },
  "matchProfiles": {
    "list": [
      {
        "field": "/list",
        "label": "List",
        "op": "eq",
        "widget": "text"
      }
    ],
    "task": [
      {
        "field": "/list",
        "label": "List",
        "op": "eq",
        "widget": "text"
      },
      {
        "field": "/title",
        "label": "Task",
        "op": "eq",
        "widget": "text"
      }
    ]
  },
  "connection": {
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "token": {
          "type": "string",
          "writeOnly": true
        }
      },
      "required": ["url"]
    },
    "ui": {}
  },
  "sensitiveKeys": [],
  "network": {
    "hosts": ["127.0.0.1"]
  }
}
