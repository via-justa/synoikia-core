# Where the SQLite DB, master key (if not provided below) and installed plugins live.
DATA_DIR=/data

# 32 bytes, base64. Generate with: openssl rand -base64 32
# If unset, a key is generated at DATA_DIR/master.key on first boot (not recommended for production).
MASTER_KEY=

# MCP listener: serves /{slug} endpoints, OAuth, approval links. Expose publicly via your reverse proxy.
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Admin listener: portal UI + Admin API. Keep LAN/VPN-only.
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8081

# Public URLs as seen by clients. OAuth stays off until PUBLIC_MCP_URL is set; also used for notification links.
PUBLIC_MCP_URL=https://mcp.example.com
# Other host names the MCP port answers to (comma-separated). PUBLIC_MCP_URL's host, localhost and IP
# addresses are always allowed; any other Host is refused (DNS-rebinding defence).
# MCP_ALLOWED_HOSTS=mcp.lan
PUBLIC_ADMIN_URL=https://admin.lan

# Honor X-Forwarded-* headers from the reverse proxy: true for one proxy, or the number of chained proxies.
TRUST_PROXY=true

# Optional: create the first admin user on boot when no users exist (ignored afterwards).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Break-glass: re-enable local password login if it was disabled in favor of OIDC.
ADMIN_FORCE_LOCAL_LOGIN=false

# debug | info | warn | error. Refused MCP requests log their reason at warn; debug adds every MCP-port request.
LOG_LEVEL=info
